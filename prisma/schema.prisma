// =============================================================================
// Souk — data model
//
// Prisma is the single source of truth for the database schema. Nothing is
// created by hand in the Supabase SQL editor; every change goes through a
// migration in prisma/migrations so environments stay reproducible.
//
// Note for anyone used to Prisma 6 and earlier: the datasource block carries
// no `url` and no `directUrl`. Prisma 7 takes connection strings from two
// places instead —
//   * the running app  -> a driver adapter, see lib/prisma.ts (pooled)
//   * the CLI          -> prisma.config.ts (direct)
//
// -----------------------------------------------------------------------------
// CONVENTIONS
//
// Money      Every amount is an INTEGER in the currency's minor unit —
//            millimes for TND, centimes for MAD, cents for EUR. Never a float:
//            0.1 + 0.2 !== 0.3, and an order total accumulated in floats drifts
//            until the invoice stops matching the sum of its lines. TND has
//            THREE decimal places, so 12.345 TND is stored as 12345. See
//            lib/money.ts.
//
// Translations  Two patterns, applied by a rule rather than case by case:
//            * Content edited as a first-class record — Product, Category,
//              Testimonial, ContentBlock, DeliveryZone — gets a `*Translation`
//              table keyed `@@unique([<entity>Id, locale])`. Adding a fourth
//              locale is then a data change, not a migration, which matches the
//              admin's "active languages" setting.
//            * Short incidental strings attached to a record — image alt text,
//              order line snapshots — use a `Json` locale map ({ ar, en, fr }),
//              validated by Zod at the boundary. A translation table for an
//              image caption costs a join and buys nothing.
//
// Ids        UUID v7. Time-ordered, so inserts land at the right-hand edge of
//            the B-tree instead of scattering across it the way v4 does. Still
//            opaque to the outside world, unlike a serial.
//
// Naming     Models are PascalCase and map to snake_case tables, which is what
//            every Supabase tool and raw SQL query expects.
//
// Deletion   Records that orders point at are never hard-deleted. An order must
//            still render years later, so product and customer references use
//            SetNull and the line carries its own snapshot.
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// ENUMS
// =============================================================================

/// Kept in step with i18n/routing.ts. Adding a locale here is a migration;
/// adding one to a *Translation row is not.
enum Locale {
  AR
  EN
  FR

  @@map("locale")
}

enum UserRole {
  /// Full access, including settings, users and destructive actions.
  ADMIN
  /// Day-to-day operations: products, orders, deliveries. No settings, no users.
  MANAGER

  @@map("user_role")
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  /// Withdrawn from sale but preserved, because past orders still reference it.
  ARCHIVED

  @@map("product_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED

  @@map("payment_status")
}

/// Cash on delivery is the only method today. It is an enum rather than a
/// boolean so adding a gateway later is one value and one branch, not a
/// migration of every order row.
enum PaymentMethod {
  CASH_ON_DELIVERY

  @@map("payment_method")
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED

  @@map("delivery_status")
}

/// Groups settings and content blocks for the admin UI. Purely presentational.
enum SettingGroup {
  GENERAL
  CONTACT
  SOCIAL
  APPEARANCE
  COMMERCE

  @@map("setting_group")
}

// =============================================================================
// USERS
// =============================================================================

/// An admin or manager account.
///
/// `id` is the Supabase Auth user id (`auth.users.id`), not a separate key.
/// There is no foreign key to `auth.users`: it lives in another schema that
/// Prisma does not manage, and a cross-schema constraint would make every
/// migration depend on Supabase internals. The link is enforced in application
/// code, which is the only place that creates these rows.
///
/// Credentials are never stored here — Supabase Auth owns them.
model User {
  id       String   @id @db.Uuid
  email    String   @unique
  fullName String?  @map("full_name")
  role     UserRole @default(MANAGER)
  isActive Boolean  @default(true) @map("is_active")

  /// Which language the admin interface renders in for this user. Independent
  /// of the content locale they happen to be editing.
  preferredLocale Locale @default(FR) @map("preferred_locale")

  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  orderEvents    OrderStatusEvent[]
  restockRecords RestockRecord[]
  uploadedMedia  MediaAsset[]

  @@index([role])
  @@map("users")
}

// =============================================================================
// CATALOGUE
// =============================================================================

model Category {
  id String @id @default(uuid(7)) @db.Uuid

  /// Locale-neutral identifier, used in the admin and in internal references.
  /// Customer-facing URLs use the per-locale slug on CategoryTranslation.
  slug String @unique

  parentId  String? @map("parent_id") @db.Uuid
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")
  imageUrl  String? @map("image_url")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Self-relation for nesting. SetNull rather than Cascade: deleting a parent
  /// promotes its children to the top level instead of silently taking a whole
  /// subtree of categories — and their product links — with it.
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  children Category[] @relation("CategoryTree")

  translations CategoryTranslation[]
  products     Product[]

  @@index([parentId])
  @@index([isActive, sortOrder])
  @@map("categories")
}

model CategoryTranslation {
  id         String @id @default(uuid(7)) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  locale     Locale

  name        String
  /// Per-locale URL segment, e.g. /ar/…/فوانيس vs /fr/…/lanternes.
  slug        String
  description String? @db.Text

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([categoryId, locale])
  @@unique([locale, slug])
  @@map("category_translations")
}

model Product {
  id  String @id @default(uuid(7)) @db.Uuid
  sku String @unique

  /// Minor units. See the money convention at the top of this file.
  price          Int
  /// Struck-through "was" price. Must be greater than `price` when set —
  /// enforced by a check constraint in the RLS/constraints migration, because
  /// a compare-at price below the selling price is a false discount.
  compareAtPrice Int? @map("compare_at_price")

  /// On-hand quantity. Decremented inside the order transaction, and held at or
  /// above zero by a check constraint so a race cannot oversell.
  stock             Int @default(0)
  lowStockThreshold Int @default(5) @map("low_stock_threshold")

  status      ProductStatus @default(DRAFT)
  /// Editorial flag, set by hand in the admin. Distinct from "recently created":
  /// a restocked classic can be worth flagging, and a genuinely new product may
  /// not be.
  isNew       Boolean       @default(false) @map("is_new")
  isFeatured  Boolean       @default(false) @map("is_featured")
  /// Denormalised units sold, maintained inside the order transaction. Drives
  /// the Best Sellers section, which would otherwise aggregate every order line
  /// on every render of the home page.
  salesCount  Int           @default(0) @map("sales_count")
  weightGrams Int?          @map("weight_grams")

  categoryId String? @map("category_id") @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid

  publishedAt DateTime? @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  supplier Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  translations   ProductTranslation[]
  images         ProductImage[]
  orderItems     OrderItem[]
  restockRecords RestockRecord[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([supplierId])
  /// Best Sellers and New Arrivals both read a small top-N slice of the whole
  /// catalogue; without these they are a full scan and a sort on every request.
  @@index([status, salesCount(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@map("products")
}

model ProductTranslation {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  locale    Locale

  name             String
  slug             String
  shortDescription String? @map("short_description")
  description      String? @db.Text
  metaTitle        String? @map("meta_title")
  metaDescription  String? @map("meta_description")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([productId, locale])
  @@unique([locale, slug])
  @@map("product_translations")
}

model ProductImage {
  id        String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid

  url String

  /// Locale map: { "AR": "…", "EN": "…", "FR": "…" }. Required, not optional —
  /// the design system treats alt text as part of uploading an image, and an
  /// optional column is one that ends up empty.
  altText Json @map("alt_text")

  /// Intrinsic dimensions, captured at upload. next/image needs them to reserve
  /// space before the file arrives; without them the product grid reflows as
  /// images load, which is the main source of layout shift on a catalogue page.
  width  Int?
  height Int?

  sortOrder Int     @default(0) @map("sort_order")
  /// Exactly one primary image per product, enforced by a partial unique index
  /// in the constraints migration.
  isPrimary Boolean @default(false) @map("is_primary")

  mediaAssetId String? @map("media_asset_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, sortOrder])
  @@index([mediaAssetId])
  @@map("product_images")
}

// =============================================================================
// SUPPLIERS
// =============================================================================

model Supplier {
  id            String  @id @default(uuid(7)) @db.Uuid
  name          String
  contactPerson String? @map("contact_person")
  email         String?
  phone         String?
  address       String? @db.Text
  notes         String? @db.Text
  isActive      Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products       Product[]
  restockRecords RestockRecord[]

  @@index([isActive, name])
  @@map("suppliers")
}

/// One purchase from a supplier: what arrived, how much it cost, when.
///
/// Kept separate from the product's `stock` counter so the admin can answer
/// "what did we pay for this and when did it last arrive" — a running total
/// cannot.
model RestockRecord {
  id         String  @id @default(uuid(7)) @db.Uuid
  supplierId String? @map("supplier_id") @db.Uuid
  productId  String? @map("product_id") @db.Uuid

  quantity Int
  /// Cost per unit in minor units. What the store paid, not what it charges.
  unitCost Int? @map("unit_cost")

  reference String?
  notes     String? @db.Text

  receivedAt   DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  recordedById String?  @map("recorded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  product    Product?  @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recordedBy User?     @relation(fields: [recordedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([supplierId, receivedAt(sort: Desc)])
  @@index([productId, receivedAt(sort: Desc)])
  @@index([recordedById])
  @@map("restock_records")
}

// =============================================================================
// CUSTOMERS
// =============================================================================

/// A person who has ordered.
///
/// There is no account and no password: checkout is guest-only with cash on
/// delivery. A customer is identified by phone number, which is the one field
/// every buyer here reliably has and the one the delivery driver actually uses.
/// Email is optional.
model Customer {
  id        String  @id @default(uuid(7)) @db.Uuid
  firstName String  @map("first_name")
  lastName  String? @map("last_name")
  phone     String  @unique
  email     String?

  /// Language this customer ordered in, so confirmations and any future
  /// notifications go out in the right one.
  preferredLocale Locale @default(AR) @map("preferred_locale")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  addresses CustomerAddress[]
  orders    Order[]

  @@index([email])
  @@map("customers")
}

model CustomerAddress {
  id         String @id @default(uuid(7)) @db.Uuid
  customerId String @map("customer_id") @db.Uuid

  label      String?
  line1      String
  line2      String?
  city       String
  postalCode String? @map("postal_code")

  deliveryZoneId String? @map("delivery_zone_id") @db.Uuid

  isDefault Boolean @default(false) @map("is_default")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([customerId])
  @@index([deliveryZoneId])
  @@map("customer_addresses")
}

// =============================================================================
// DELIVERY
// =============================================================================

/// A shipping region and its fee, so checkout can price delivery automatically
/// instead of asking an operator.
model DeliveryZone {
  id   String @id @default(uuid(7)) @db.Uuid
  /// Locale-neutral key, e.g. "tunis". Names are translated.
  code String @unique

  /// Minor units. Zero is a valid fee (free delivery in this zone).
  shippingFee Int @map("shipping_fee")

  /// Order subtotal at or above which delivery is free in this zone. Null means
  /// the fee always applies.
  freeShippingThreshold Int? @map("free_shipping_threshold")

  estimatedDaysMin Int?    @map("estimated_days_min")
  estimatedDaysMax Int?    @map("estimated_days_max")
  isActive         Boolean @default(true) @map("is_active")
  sortOrder        Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations DeliveryZoneTranslation[]
  orders       Order[]
  deliveries   Delivery[]
  addresses    CustomerAddress[]

  @@index([isActive, sortOrder])
  @@map("delivery_zones")
}

model DeliveryZoneTranslation {
  id     String @id @default(uuid(7)) @db.Uuid
  zoneId String @map("zone_id") @db.Uuid
  locale Locale

  /// Tunisian place names differ genuinely between scripts and languages —
  /// صفاقس / Sfax / Sfax — so the zone selector must be translated like any
  /// other customer-facing content.
  name String

  zone DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([zoneId, locale])
  @@map("delivery_zone_translations")
}

/// The physical dispatch of an order: who is carrying it and where it has got to.
///
/// Separate from Order.status because the two answer different questions. An
/// order can be CONFIRMED while no driver has been assigned, and a delivery can
/// fail and be retried without the order changing state.
model Delivery {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @unique @map("order_id") @db.Uuid

  carrierName    String? @map("carrier_name")
  driverName     String? @map("driver_name")
  driverPhone    String? @map("driver_phone")
  /// Unique when present: two shipments cannot share a tracking number.
  trackingNumber String? @unique @map("tracking_number")

  deliveryZoneId String? @map("delivery_zone_id") @db.Uuid
  /// Fee actually charged, copied from the zone at order time. The zone's fee
  /// can change tomorrow; what this customer paid cannot.
  shippingFee    Int     @map("shipping_fee")

  status DeliveryStatus @default(PENDING)
  notes  String?        @db.Text

  dispatchedAt DateTime? @map("dispatched_at") @db.Timestamptz(6)
  deliveredAt  DateTime? @map("delivered_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  order Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  zone  DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([status, createdAt(sort: Desc)])
  @@index([deliveryZoneId])
  @@map("deliveries")
}

// =============================================================================
// ORDERS
// =============================================================================

model Order {
  id String @id @default(uuid(7)) @db.Uuid

  /// Human-readable, given to the customer and used for tracking. Generated
  /// from a Postgres sequence in the constraints migration rather than counted
  /// in application code, which would race under concurrent checkouts.
  orderNumber String @unique @map("order_number")

  customerId String? @map("customer_id") @db.Uuid

  // --- Contact and address snapshot ----------------------------------------
  // Copied at order time, not read through the customer relation. A customer
  // who moves house must not silently rewrite where last year's parcel went.
  contactName  String  @map("contact_name")
  contactPhone String  @map("contact_phone")
  contactEmail String? @map("contact_email")

  shippingLine1      String  @map("shipping_line1")
  shippingLine2      String? @map("shipping_line2")
  shippingCity       String  @map("shipping_city")
  shippingPostalCode String? @map("shipping_postal_code")

  deliveryZoneId String? @map("delivery_zone_id") @db.Uuid

  // --- Money ----------------------------------------------------------------
  // All minor units, all recomputed server-side at creation. The figures the
  // browser showed are a preview and are never trusted.
  subtotal     Int
  shippingCost Int @map("shipping_cost")
  discount     Int @default(0)
  total        Int

  /// Currency snapshot. `currencyDecimals` travels with it because the store's
  /// currency is a setting: if it changes from TND (3 decimals) to EUR (2), old
  /// orders must still format as the amounts they were.
  currency         String @db.VarChar(3)
  currencyDecimals Int    @map("currency_decimals")

  paymentMethod PaymentMethod @default(CASH_ON_DELIVERY) @map("payment_method")
  paymentStatus PaymentStatus @default(PENDING) @map("payment_status")
  status        OrderStatus   @default(PENDING)

  /// Language the order was placed in — for the confirmation, the invoice and
  /// anything sent to the customer later.
  locale Locale @default(AR)

  customerNote String? @map("customer_note") @db.Text
  internalNote String? @map("internal_note") @db.Text

  /// Guards against a double-submitted checkout producing two orders. Unique,
  /// so the second insert loses at the database rather than in a code path that
  /// might not run.
  idempotencyKey String? @unique @map("idempotency_key")

  placedAt    DateTime  @default(now()) @map("placed_at") @db.Timestamptz(6)
  confirmedAt DateTime? @map("confirmed_at") @db.Timestamptz(6)
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz(6)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  items         OrderItem[]
  delivery      Delivery?
  statusHistory OrderStatusEvent[]

  @@index([status, placedAt(sort: Desc)])
  @@index([customerId, placedAt(sort: Desc)])
  @@index([placedAt(sort: Desc)])
  @@index([deliveryZoneId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  /// SetNull, not Cascade: a deleted product must not take order history with
  /// it. The snapshot below is what the invoice renders.
  productId String? @map("product_id") @db.Uuid

  /// Locale map of the product name as it was at purchase, so an order placed
  /// in Arabic still reads correctly to an admin working in French, and a later
  /// rename does not rewrite history.
  productName Json    @map("product_name")
  productSku  String  @map("product_sku")
  imageUrl    String? @map("image_url")

  /// Price per unit at purchase, minor units.
  unitPrice Int @map("unit_price")
  quantity  Int
  /// unitPrice * quantity, stored rather than derived: it is the number on the
  /// invoice, and a check constraint keeps the two in agreement.
  lineTotal Int @map("line_total")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Append-only audit of order state changes: who moved it, when, and why.
///
/// Without this, "why was this order cancelled" has no answer three weeks later.
model OrderStatusEvent {
  id      String @id @default(uuid(7)) @db.Uuid
  orderId String @map("order_id") @db.Uuid

  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  note       String?      @db.Text

  /// Null for automatic transitions (e.g. the initial PENDING on creation).
  changedById String? @map("changed_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([orderId, createdAt])
  @@index([changedById])
  @@map("order_status_events")
}

// =============================================================================
// CONTENT
// =============================================================================

model Testimonial {
  id           String  @id @default(uuid(7)) @db.Uuid
  customerName String  @map("customer_name")
  photoUrl     String? @map("photo_url")
  /// 1–5, held in range by a check constraint.
  rating       Int     @default(5)

  isPublished Boolean @default(false) @map("is_published")
  sortOrder   Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations TestimonialTranslation[]

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

model TestimonialTranslation {
  id            String @id @default(uuid(7)) @db.Uuid
  testimonialId String @map("testimonial_id") @db.Uuid
  locale        Locale

  message String  @db.Text
  /// "Interior designer", "Restaurant owner" — shown under the name.
  role    String?

  testimonial Testimonial @relation(fields: [testimonialId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([testimonialId, locale])
  @@map("testimonial_translations")
}

/// An editable piece of site copy, addressed by slug.
///
/// Every string the storefront renders that is not a UI label comes from here:
/// hero title, hero subtitle, the three value-proposition cards, footer text,
/// about text. Components look blocks up by slug and never hold copy.
model ContentBlock {
  id    String       @id @default(uuid(7)) @db.Uuid
  slug  String       @unique
  group SettingGroup @default(GENERAL)

  /// What this block is, shown to the admin next to the fields. Not rendered on
  /// the storefront, so it is not translated.
  label String

  /// Long-form blocks get a textarea in the admin, short ones a single line.
  isMultiline Boolean @default(false) @map("is_multiline")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  translations ContentBlockTranslation[]

  @@index([group])
  @@map("content_blocks")
}

model ContentBlockTranslation {
  id      String @id @default(uuid(7)) @db.Uuid
  blockId String @map("block_id") @db.Uuid
  locale  Locale

  value String @db.Text

  block ContentBlock @relation(fields: [blockId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([blockId, locale])
  @@map("content_block_translations")
}

/// Key/value store for everything configurable that is not prose: logo,
/// favicon, store name, contact details, social links, currency, colours.
///
/// `value` is Json so one table holds a string, a number, a boolean and a list
/// of social links without a column per setting. Every read goes through a Zod
/// schema keyed by `key`, so the looseness stops at the boundary.
model SiteSetting {
  key   String       @id
  value Json
  group SettingGroup @default(GENERAL)
  label String

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([group])
  @@map("site_settings")
}

/// A file in Supabase Storage, reusable anywhere on the site.
///
/// `path` is the key inside the bucket and is what deletes and signed URLs
/// need; `url` is the public form, denormalised so rendering never has to
/// rebuild it.
model MediaAsset {
  id     String @id @default(uuid(7)) @db.Uuid
  bucket String @default("media")
  path   String
  url    String

  fileName  String  @map("file_name")
  mimeType  String  @map("mime_type")
  sizeBytes Int     @map("size_bytes")
  width     Int?
  height    Int?
  /// Locale map, same shape as ProductImage.altText.
  altText   Json?   @map("alt_text")
  folder    String?

  uploadedById String? @map("uploaded_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  uploadedBy    User?          @relation(fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  productImages ProductImage[]

  @@unique([bucket, path])
  @@index([folder, createdAt(sort: Desc)])
  @@index([uploadedById])
  @@map("media_assets")
}

# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local — it is git-ignored.
#
# All values come from the Supabase dashboard:
#   Project Settings -> Database  (connection strings)
#   Project Settings -> API       (URL and keys)
# =============================================================================

# --- Database ----------------------------------------------------------------
# Pooled connection (Transaction mode, port 6543). This is what the running app
# uses. Serverless functions open a connection per invocation, and a direct
# connection pool would exhaust Postgres under any real traffic.
# `pgbouncer=true` tells Prisma to skip prepared statements, which transaction
# pooling cannot support.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Direct connection (Session mode, port 5432). Migrations only.
# `prisma migrate` takes advisory locks and runs DDL, neither of which works
# through a transaction pooler.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase ----------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable ("anon") key. Safe in the browser: every request it makes is
# subject to Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# Service-role key. BYPASSES Row Level Security — it is a full-database
# credential. Server-side only. If this ever appears in a NEXT_PUBLIC_
# variable, in client code, or in a committed file, rotate it immediately.
SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"

# --- Application -------------------------------------------------------------
# Absolute origin. Used for canonical URLs, hreflang alternates, the sitemap,
# and Supabase Auth redirect callbacks. No trailing slash.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Build escape hatch ------------------------------------------------------
# Set to 1 to skip environment validation. For CI type-checks and container
# builds that have no database. Never set it in a running deployment.
# SKIP_ENV_VALIDATION=1

# --- Optional tooling --------------------------------------------------------
# 21st.dev MCP server (component search during development). Not required to
# build or run the app.
# TWENTYFIRST_API_KEY="<key>"
